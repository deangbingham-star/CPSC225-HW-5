//**********************************************


class fraction
{
public:

	fraction()
	{
		cout<<"\nDebug.Created Fraction\n"<<endl;
	}


	fraction(int n, int d, int w)
	{
		numerator = n;
		denominator = d;
		wholeNum = w;
	}


	int getNumerator() {
		return numerator;
	}
	int getDenominator() {
		return denominator;
	}
	int getWholeNum() {
		return wholeNum;
	}

private:
	int numerator;
	int denominator;
	int wholeNum;


};
//***********************************************
fraction mixify(fraction g)  //Mix improper fraction into mixed fraction
{
    int numerator = g.getNumerator();
    int denominator = g.getDenominator();
    int wholeNum = g.getWholeNum();

	while (numerator >= denominator)
	{
		wholeNum ++;
		numerator = numerator - denominator;
	}

	//	displayNum(numerator,denominator,wholeNum);
	return fraction(numerator,denominator,wholeNum);
}
//***********************************************



void displayNum(fraction f) //display function as improper function
{
	int numerator = f.getNumerator();
	int denominator = f.getDenominator();
	int wholeNum = f.getWholeNum();

	cout<<"Full Number: "<<wholeNum<<" "<<numerator<<"/"<<denominator<<endl;

}
//*************************************************
fraction multiply(fraction f1, fraction f2) //take two fractions, multiply. Store results in third fraction
{
    int sumNumerator = f1.getNumerator() * f2.getNumerator();
    int sumDenomerator = f1.getDenominator() * f2.getDenominator();
    int sumWholeNumbers = f1.getWholeNum() * f2.getWholeNum();
    return fraction(sumNumerator,sumDenomerator,sumWholeNumbers);
}

