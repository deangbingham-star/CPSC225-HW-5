int mixify(int numerator, int denominator, int wholeNum)  //Mix improper fraction into mixed fraction
{
    int numerator = numerator;
    int denominator = denominator;
    int wholeNum = wholeNum;
    while (numerator >= denominator)
	{
	    wholeNum ++;
	    numerator = numerator - denominator;
	}

//	displayNum(numerator,denominator,wholeNum);
